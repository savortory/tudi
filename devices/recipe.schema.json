{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "tudi.device.recipe"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "manufacturer": {
      "type": "string",
      "maxLength": 120
    },
    "model": {
      "type": "string",
      "maxLength": 120
    },
    "deviceType": {
      "const": "camera"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "rtsp",
            "mjpeg",
            "onvif"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^/(?!/)(?!.*[\\\\\\s#])(?!.*(?:password|passwd|token|secret|auth)=)"
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "minItems": 1,
              "maxItems": 16
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^/(?!/)(?!.*[\\\\\\s#])(?!.*(?:password|passwd|token|secret|auth)=)"
              },
              "minItems": 1,
              "maxItems": 16
            }
          },
          "required": [
            "ports",
            "paths"
          ]
        },
        "audioEnabled": {
          "type": "boolean"
        },
        "supportsSnapshot": {
          "type": "boolean"
        },
        "supportsRecording": {
          "type": "boolean"
        },
        "tudiSense": {
          "type": "boolean"
        },
        "ptz": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "auto",
                "onvif",
                "wificam_cgi",
                "disabled"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^/(?!/)(?!.*[\\\\\\s#])(?!.*(?:password|passwd|token|secret|auth)=)"
            }
          },
          "required": [
            "mode"
          ]
        }
      },
      "required": [
        "protocol",
        "port",
        "path",
        "discovery"
      ]
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "revision",
    "name",
    "deviceType",
    "config"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "config": {
            "properties": {
              "tudiSense": {
                "const": true
              }
            },
            "required": [
              "tudiSense"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "protocol": {
                "const": "mjpeg"
              }
            }
          }
        }
      }
    }
  ]
}
